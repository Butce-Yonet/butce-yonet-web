# Copy to .env.development, .env.staging, .env.production and fill in the values.
VUE_APP_ENV=

# Auth Server Configuration
VUE_APP_AUTH_SERVER_URL=
VUE_APP_AUTH_SERVER_REDIRECT_URL=

# API Configuration
VUE_APP_API_URL=

# Firebase Configuration
VUE_APP_FIREBASE_API_KEY=
VUE_APP_FIREBASE_AUTH_DOMAIN=
VUE_APP_FIREBASE_PROJECT_ID=
VUE_APP_FIREBASE_STORAGE_BUCKET=
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=
VUE_APP_FIREBASE_APP_ID=
VUE_APP_FIREBASE_MEASUREMENT_ID=
# Web push certificate key (Firebase Console > Project settings > Cloud Messaging > Web Push certificates).
# Push notifications stay disabled while this is empty.
VUE_APP_FIREBASE_VAPID_KEY=
